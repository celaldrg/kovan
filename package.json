{
  "name": "kovan",
  "version": "0.1.1",
  "description": "Kovan — all your Claude Code and Codex sessions in one live 3D hive. See who's working, who's stuck and who needs you, and approve without hunting through terminal tabs.",
  "type": "module",
  "author": "Celalettin Durğaç (https://celaldrg.github.io)",
  "license": "MIT",
  "homepage": "https://github.com/celaldrg/kovan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celaldrg/kovan.git"
  },
  "bin": {
    "kovan": "./bin/kovan.mjs"
  },
  "bugs": {
    "url": "https://github.com/celaldrg/kovan/issues"
  },
  "keywords": [
    "ai-agents",
    "threejs",
    "3d",
    "knowledge-graph",
    "claude-code",
    "obsidian",
    "local-first",
    "automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "dev": "concurrently -k -n api,web \"node server/index.mjs\" \"vite\"",
    "build": "tsc -p . && vite build",
    "prestart": "node -e \"process.exit(require('fs').existsSync('dist/index.html')?0:1)\" || npm run build",
    "start": "node server/index.mjs",
    "demo": "cross-env KOVAN_DEMO=1 node server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "test": "node scripts/test.mjs",
    "hooks:install": "node bin/kovan.mjs hooks install",
    "hooks:uninstall": "node bin/kovan.mjs hooks uninstall",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "dist",
    "vault",
    "crew.json",
    "kovan.config.json"
  ],
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "lucide": "^1.77.0",
    "puppeteer-core": "^23.0.0",
    "three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

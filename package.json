{
  "name": "kovan",
  "version": "0.1.0",
  "description": "Kovan — a living 3D honeycomb where AI departments of worker bees take tasks, read your notes and file results back. Runs locally on your own AI CLI.",
  "type": "module",
  "author": "Celalettin Durğaç (https://celaldrg.github.io)",
  "license": "MIT",
  "homepage": "https://github.com/celaldrg/kovan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celaldrg/kovan.git"
  },
  "bugs": {
    "url": "https://github.com/celaldrg/kovan/issues"
  },
  "keywords": [
    "ai-agents",
    "threejs",
    "3d",
    "knowledge-graph",
    "claude-code",
    "obsidian",
    "local-first",
    "automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "dev": "concurrently -k -n api,web \"node server/index.mjs\" \"vite\"",
    "build": "tsc -p . && vite build",
    "prestart": "node -e \"process.exit(require('fs').existsSync('dist/index.html')?0:1)\" || npm run build",
    "start": "node server/index.mjs",
    "demo": "KOVAN_DEMO=1 node server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "test": "node --test shared/*.test.js"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "lucide": "^1.77.0",
    "puppeteer-core": "^23.0.0",
    "three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

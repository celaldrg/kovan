# Environment variables Kovan reads. This file is an example only.
# Kovan does not load .env by itself. Export the variables, or leave them unset.
# Do not put a real key in this file.

# Optional. Used only when the Claude Code CLI is not installed.
# Leave these empty. Kovan reads keys from the environment. It does not write them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Ollama. Default is loopback. A non-loopback host is ignored unless KOVAN_OLLAMA_ALLOW_REMOTE=1.
OLLAMA_HOST=http://127.0.0.1:11434

# Listen port. Default 4700.
KOVAN_PORT=4700

# Bind address. Default 127.0.0.1. Set this only to expose Kovan on purpose.
KOVAN_HOST=127.0.0.1

# Extra Host names allowed when KOVAN_HOST is not loopback. Comma-separated. Empty by default.
KOVAN_HOST_ALLOW=

# Set to 1 for the simulated live hive.
KOVAN_DEMO=

# Vault directory. Default is ./vault inside the clone.
KOVAN_VAULT=

# Data directory for the token, cost ledger and replay files. Default is ./data inside the clone.
KOVAN_DATA=

# Session replay. Unset or 1 records. 0 turns recording off.
KOVAN_REPLAY=
# How many days of timeline to keep. Default 30.
KOVAN_REPLAY_DAYS=

# Comma-separated project directories to scan for .aider.chat.history.md. Aider has no global session index.
KOVAN_AIDER_DIRS=

# Phone approvals. Off unless set to 1. The launch token is not shared with the phone.
KOVAN_PHONE=

# URL the phone can open. Required for the pairing QR. Loopback is not reachable from a phone.
# Use a LAN address (http://192.0.2.10:4700) or the https origin of a tunnel you run yourself.
KOVAN_PUBLIC_ORIGIN=

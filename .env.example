# Environment variables Kovan reads. This file is an example only.
# Kovan does not load .env by itself. Export the variables, or leave them unset.
# Do not put a real key in this file.

# Optional. Used only when the Claude Code CLI is not installed.
ANTHROPIC_API_KEY=

# Listen port. Default 4700.
KOVAN_PORT=4700

# Bind address. Default 127.0.0.1. Set this only to expose Kovan on purpose.
KOVAN_HOST=127.0.0.1

# Extra Host names allowed when KOVAN_HOST is not loopback. Comma-separated. Empty by default.
KOVAN_HOST_ALLOW=

# Set to 1 for the simulated live hive.
KOVAN_DEMO=

# Vault directory. Default is ./vault inside the clone.
KOVAN_VAULT=

# Data directory for the token and local JSON. Default is ./data inside the clone.
KOVAN_DATA=
